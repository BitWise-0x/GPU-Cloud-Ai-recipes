# FaceFusion pod. Copy to pod.env (gitignored) and edit.
# Every value here can be overridden for one run inline (runpod/README.md), for example
#   RUNPOD_CLOUD_TYPE=COMMUNITY ../../pod-kit/pod.sh . start photo

# The image you built and pushed (pod-kit/build.sh, or the build-image
# workflow, which pushes to ghcr.io/<owner>/<repo>/<recipe>). A new tag per build.
RUNPOD_IMAGE=ghcr.io/your-user/gpu-cloud-recipes/facefusion:v1
RUNPOD_POD_NAME=facefusion-pod
RUNPOD_TEMPLATE_NAME=facefusion-pod

# FaceFusion's port inside the pod, and the local end of the SSH tunnel to it:
# http://127.0.0.1:17960. Not 7860, so a local FaceFusion can keep that port.
POD_APP_PORT=7860
RUNPOD_TUNNEL_PORT=17960

# The image is about 6 GB extracted; the rest is uploads and outputs. The
# container disk is wiped when the pod stops: copy /workspace/output off first.
RUNPOD_CONTAINER_DISK_GB=60
RUNPOD_VOLUME_GB=0
RUNPOD_CLOUD_TYPE=SECURE

# Two GPU lists, picked by the start command:
#   pod.sh <dir> start photo   stills: one frame, no encode, few CPU cores.
#                              The cheapest card that fits wins.
#   pod.sh <dir> start video   video: every frame is decoded, processed and
#                              encoded. NVENC cards first (the encode runs on
#                              the GPU, leaving the CPU to the face work);
#                              A100 and H100 last: no NVENC, and pricier.
# Every card below has at least 16 GB of VRAM. Check a 1080p job's use with
# nvidia-smi on the pod before you add a smaller card. The exact names come from
# GET https://api.runpod.io/v2/catalog/gpus.
RUNPOD_GPU_TYPES_PHOTO="NVIDIA RTX 2000 Ada Generation|NVIDIA RTX A4000|NVIDIA RTX 4000 Ada Generation|NVIDIA RTX A4500|NVIDIA RTX A5000|NVIDIA RTX PRO 4000 Blackwell|NVIDIA L4|NVIDIA RTX A6000|NVIDIA A40|NVIDIA RTX PRO 4500 Blackwell|NVIDIA GeForce RTX 3090|NVIDIA L40|NVIDIA GeForce RTX 4090|NVIDIA RTX 6000 Ada Generation|NVIDIA L40S"
RUNPOD_MIN_VCPU_PER_GPU_PHOTO=
RUNPOD_GPU_TYPES_VIDEO="NVIDIA L40|NVIDIA L40S|NVIDIA RTX 6000 Ada Generation|NVIDIA GeForce RTX 4090|NVIDIA GeForce RTX 5090|NVIDIA RTX PRO 6000 Blackwell Server Edition|NVIDIA RTX PRO 4500 Blackwell|NVIDIA RTX A6000|NVIDIA A40|NVIDIA RTX A5000|NVIDIA GeForce RTX 3090|NVIDIA A100-SXM4-80GB|NVIDIA H100 NVL|NVIDIA H100 80GB HBM3"
# Face detection, masks and paste-back run on the CPU, so a video job on a host
# with few vCPUs leaves the GPU waiting. The same GPU type comes with 16 vCPUs
# on one host and 32 on another; ask for a floor first (docs/gpu-selection.md).
RUNPOD_MIN_VCPU_PER_GPU_VIDEO=24
RUNPOD_MIN_VCPU_WALKS=9
RUNPOD_MIN_VCPU_STRICT=1
# `start` without a list walks this one.
RUNPOD_GPU_TYPES="${RUNPOD_GPU_TYPES_PHOTO}"

# RunPod matches this list exactly: every 13.x minor, so a newer 13.x driver
# (which runs the 13.0 image fine) is not left out.
RUNPOD_ALLOWED_CUDA_VERSIONS=13.0,13.1,13.2,13.3,13.4,13.5,13.6,13.7,13.8,13.9
RUNPOD_COUNTRY_CODES=US,CA
RUNPOD_COUNTRY_FALLBACK=1

# Optional Cloudflare Tunnel (docs/access.md). Empty = SSH tunnel only.
CF_TUNNEL_NAME=
CF_PUBLIC_HOSTNAME=

# Template env: every FACEFUSION_* variable is copied into the RunPod template.
POD_ENV_PREFIX=FACEFUSION_
FACEFUSION_LISTEN=127.0.0.1
FACEFUSION_EXTRA_ARGS=
