# ComfyUI video upscale pod. Copy to pod.env (gitignored) and edit.
# Every value here can be overridden for one run inline (runpod/README.md), for example
#   RUNPOD_GPU_TYPES="NVIDIA L40S" ../../pod-kit/pod.sh . start

# The image you built and pushed (pod-kit/build.sh, or the build-image
# workflow, which pushes to ghcr.io/<owner>/<repo>/<recipe>). A new tag per build.
RUNPOD_IMAGE=ghcr.io/your-user/gpu-cloud-recipes/comfyui-upscale:v1
RUNPOD_POD_NAME=comfyui-upscale-pod
RUNPOD_TEMPLATE_NAME=comfyui-upscale-pod

# ComfyUI's port inside the pod, and the local end of the SSH tunnel to it:
# http://127.0.0.1:18288. Not 8188, so a local ComfyUI can keep that port.
POD_APP_PORT=8188
RUNPOD_TUNNEL_PORT=18288

# Holds the image (~13 GB extracted), the SeedVR2 download (7.3 GB for 3B) and
# the working files: uploaded sources plus outputs, which for a feature film at
# 1080p crf 18 run 5-15 GB each. The container disk is wiped when the pod stops;
# copy outputs off first (scp, or the UI's download).
RUNPOD_CONTAINER_DISK_GB=120
RUNPOD_VOLUME_GB=0
# SECURE (RunPod's own data centers) or COMMUNITY (cheaper, hosted by third
# parties, can be interrupted).
RUNPOD_CLOUD_TYPE=SECURE

# GPU types, tried in order. NVENC cards first: every output is a video encode,
# and on an NVENC card it runs on the GPU. 48 GB first (SeedVR2 3B at 1080p
# wants the room), then the 96 GB RTX PRO 6000, then A100/H100/H200 last: no
# NVENC (libx264 on the CPU) and pricier. SeedVR2 7B or 2160p output needs
# 80 GB; for that run:
#   RUNPOD_GPU_TYPES="NVIDIA RTX PRO 6000 Blackwell Server Edition|NVIDIA A100-SXM4-80GB|NVIDIA H100 80GB HBM3" pod.sh <dir> start
# The exact names come from GET https://api.runpod.io/v2/catalog/gpus.
RUNPOD_GPU_TYPES="NVIDIA L40|NVIDIA L40S|NVIDIA RTX A6000|NVIDIA RTX 6000 Ada Generation|NVIDIA RTX PRO 6000 Blackwell Server Edition|NVIDIA A100-SXM4-80GB|NVIDIA H100 NVL|NVIDIA H100 80GB HBM3|NVIDIA H200"
# vCPUs per GPU to ask for first (empty = any host). The per-frame upscale is
# GPU-bound; the video decode and encode want a few cores.
RUNPOD_MIN_VCPU_PER_GPU=16
RUNPOD_MIN_VCPU_WALKS=3
RUNPOD_MIN_VCPU_STRICT=0

# Only hosts whose driver supports the image's CUDA 13.0 runtime. Without this,
# a pod can land on an older driver and fail at container start. RunPod matches
# the list exactly, so it names every 13.x minor: a newer 13.x driver runs the
# 13.0 image fine. 12.x is too old; add 14.x once you have tested it.
RUNPOD_ALLOWED_CUDA_VERSIONS=13.0,13.1,13.2,13.3,13.4,13.5,13.6,13.7,13.8,13.9
# Data centers by country or region prefix (empty = anywhere), and whether to
# try everywhere else in the same walk once those are full.
RUNPOD_COUNTRY_CODES=US,CA
RUNPOD_COUNTRY_FALLBACK=1

# Optional Cloudflare Tunnel (docs/access.md). Empty = SSH tunnel only.
CF_TUNNEL_NAME=
CF_PUBLIC_HOSTNAME=

# Template env: every variable starting with this prefix is copied into the
# RunPod template by setup.
POD_ENV_PREFIX=COMFYUI_
#   COMFYUI_MAX_UPLOAD_MB  ComfyUI's own upload cap in MB; whole films are one upload
#   COMFYUI_SEEDVR2_MODEL  SeedVR2 file start.sh downloads at boot:
#                          seedvr2_3b_fp16.safetensors (default),
#                          seedvr2_7b_fp16.safetensors or
#                          seedvr2_7b_sharp_fp16.safetensors (80 GB cards),
#                          or none. The SeedVR2 workflow's model loader must
#                          name the file.
COMFYUI_MAX_UPLOAD_MB=16384
COMFYUI_SEEDVR2_MODEL=seedvr2_3b_fp16.safetensors
COMFYUI_LISTEN=127.0.0.1
